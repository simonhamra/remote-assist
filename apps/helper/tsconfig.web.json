{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "../../packages/rtc/src/**/*.ts",
    "../../packages/protocol/src/**/*.ts"
  ],
  "exclude": ["../../packages/*/src/**/*.test.ts"]
}
