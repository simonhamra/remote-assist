{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "../../tooling/**/*.ts",
    "../../packages/desktop/src/**/*.ts",
    "../../packages/protocol/src/**/*.ts"
  ],
  "exclude": ["../../packages/*/src/**/*.test.ts"]
}
